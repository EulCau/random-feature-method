  langid = {english},
  keywords = {Computer Science - Machine Learning,Mathematics - Numerical Analysis,Statistics - Machine Learning},
  file = {/home/eulcau/Zotero/storage/CEYRRDY4/E - 2020 - Machine Learning and Computational Mathematics.pdf}
}

@misc{charikarQuasiMonteCarloData2024,
  title = {A {{Quasi-Monte Carlo Data Structure}} for {{Smooth Kernel Evaluations}}},
  author = {Charikar, Moses and Kapralov, Michael and Waingarten, Erik},
  year = 2024,
  month = jan,
  number = {arXiv:2401.02562},
  eprint = {2401.02562},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2401.02562},
  urldate = {2026-02-02},
  abstract = {In the kernel density estimation (KDE) problem one is given a kernel \$K(x, y)\$ and a dataset \$P\$ of points in a Euclidean space, and must prepare a data structure that can quickly answer density queries: given a point \$q\$, output a \$(1+{$\varepsilon$})\$-approximation to \${$\mu$}:=\textbackslash frac1\textbraceleft\textbar P\textbar\textbraceright\textbackslash sum\_\textbraceleft p\textbackslash in P\textbraceright{} K(p, q)\$. The classical approach to KDE is the celebrated fast multipole method of [Greengard and Rokhlin]. The fast multipole method combines a basic space partitioning approach with a multidimensional Taylor expansion, which yields a \$\textbackslash approx \textbackslash log\textasciicircum d (n/{$\varepsilon$})\$ query time (exponential in the dimension \$d\$). A recent line of work initiated by [Charikar and Siminelakis] achieved polynomial dependence on \$d\$ via a combination of random sampling and randomized space partitioning, with [Backurs et al.] giving an efficient data structure with query time \$\textbackslash approx \textbackslash mathrm\textbraceleft poly\textbraceright\textbraceleft\textbackslash log(1/{$\mu$})\textbraceright/{$\varepsilon$}\textasciicircum 2\$ for smooth kernels. Quadratic dependence on \${$\varepsilon\$$}, inherent to the sampling methods, is prohibitively expensive for small \${$\varepsilon\$$}. This issue is addressed by quasi-Monte Carlo methods in numerical analysis. The high level idea in quasi-Monte Carlo methods is to replace random sampling with a discrepancy based approach -- an idea recently applied to coresets for KDE by [Phillips and Tai]. The work of Phillips and Tai gives a space efficient data structure with query complexity \$\textbackslash approx 1/({$\varepsilon\mu$})\$. This is polynomially better in \$1/{$\varepsilon\$$}, but exponentially worse in \$1/{$\mu\$$}. We achieve the best of both: a data structure with \$\textbackslash approx \textbackslash mathrm\textbraceleft poly\textbraceright\textbraceleft\textbackslash log(1/{$\mu$})\textbraceright/{$\varepsilon\$$} query time for smooth kernel KDE. Our main insight is a new way to combine discrepancy theory with randomized space partitioning inspired by, but significantly more efficient than, that of the fast multipole methods. We hope that our techniques will find further applications to linear algebra for kernel matrices.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Computer Science - Data Structures and Algorithms},
  file = {/home/eulcau/Zotero/storage/HZ8EEWYN/Charikar 等 - 2024 - A Quasi-Monte Carlo Data Structure for Smooth Kernel Evaluations.pdf}
}

@misc{chenBridgingTraditionalMachine2022,
